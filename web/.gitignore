# ==========================================
# 1. ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ И СЕКРЕТЫ (САМОЕ ВАЖНОЕ)
# ==========================================
.env
**/.env.prod
.env.local
.env.*.local
# Исключение для шаблона, чтобы другие разработчики знали, какие переменные нужны
!.env.example 
!.env.template

# ==========================================
# 2. PYTHON И DJANGO
# ==========================================
# Скомпилированные файлы и кэш
__pycache__/
*.py[cod]
*$py.class
*.so

# Виртуальные окружения
.venv/
venv/
env/
ENV/

# Базы данных (локальные SQLite, если вдруг понадобятся для тестов)
*.sqlite3
*.sqlite3-journal
db.sqlite3

# Собранные статические файлы и медиа (они живут в Docker-томах)
# ВАЖНО: не путать с папками static/ внутри приложений, которые нужно коммитить!
staticfiles/
media/

# Локальные настройки Django (если используешь паттерн local_settings.py)
local_settings.py
*.log

# ==========================================
# 3. DOCKER И СЕРВЕР
# ==========================================
# Игнорируем папки, которые могут создаться, если ты случайно используешь bind-mounts вместо named volumes
postgres_data/
nginx_logs/

# ==========================================
# 4. IDE, РЕДАКТОРЫ КОДА И ОС
# ==========================================
# PyCharm / IntelliJ
.idea/
*.iml

# VS Code
.vscode/
*.code-workspace

# Vim / Emacs
*.swp
*.swo
*~
\.*.swp # скрытые swap файлы

# macOS
.DS_Store
.AppleDouble
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ==========================================
# 5. ТЕСТЫ И ПОКРЫТИЕ (Если будешь писать тесты)
# ==========================================
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/