# ==========================================
# DJANGO SETTINGS
# ==========================================

# Секретный ключ Django. ОБЯЗАТЕЛЬНО замени на свой уникальный!
# Сгенерировать можно в python-консоли: from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())
SECRET_KEY=django-insecure-change-me-in-production-1234567890abcdef

# Режим отладки. 0 - выключен (Production), 1 - включен (Development)
DEBUG=1

# Разрешенные хосты. Разделяй запятой без пробелов.
# Добавь свой домен, если он есть. Для локальной разработки оставь localhost и 127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,www.yourdomain.com

# ==========================================
# DATABASE (POSTGRESQL)
# ==========================================
# ВАЖНО: Эти переменные читаются как Django, так и самим контейнером Postgres!
# Имена должны быть строго POSTGRES_DB, POSTGRES_USER и т.д., иначе база не создастся.

POSTGRES_DB=my_django_db
POSTGRES_USER=my_django_user
POSTGRES_PASSWORD=super_secret_password_change_me

# POSTGRES_HOST должен совпадать с именем сервиса базы данных в docker-compose.yml (у нас это 'db')
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ==========================================
# REDIS / CELERY (Опционально, если используешь)
# ==========================================
# Если в будущем добавишь Redis/Celery, раскомментируй и настрой:
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/0